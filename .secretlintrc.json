{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "provider API key",
            "patterns": [
              "/sk-ant-[A-Za-z0-9_-]{10,}/",
              "/sk-proj-[A-Za-z0-9_-]{10,}/",
              "/sk-[A-Za-z0-9]{20,}/"
            ]
          },
          {
            "name": "email outside reserved example domains",
            "patterns": [
              "/[a-z0-9._%+-]+@(?!(?:[a-z0-9-]+\\.)*(?:example\\.(?:com|org|net)|[a-z0-9-]+\\.(?:test|invalid|example|localhost)|test|invalid|example|localhost)(?![\\w-]|\\.\\w))[a-z0-9-]+(?:\\.[a-z0-9-]+)*\\.[a-z]{2,}(?![\\w-])/i"
            ]
          },
          {
            "name": "phone outside reserved test ranges",
            "patterns": [
              "/(?<![\\w+])\\+(?!(?:1[ .-]?(?:\\(?\\d{3}\\)?[ .-]?555[ .-]?01\\d\\d|555[ .-]?\\d{3}[ .-]?\\d{4})|44[ .-]?7700[ .-]?900[ .-]?\\d{3}|34[ .-]?600[ .-]?000[ .-]?0\\d\\d)(?!\\d))\\d{1,3}[ .-]?\\(?\\d{2,4}\\)?(?:[ .-]?\\d{2,4}){2,3}(?!\\d)/",
              "/(?<![\\w.+-])(?!600[ .-]?000[ .-]?0\\d\\d(?!\\d))[6-9]\\d{2}[ .-]?\\d{3}[ .-]?\\d{3}(?![\\w.-])/"
            ]
          },
          {
            "name": "national ID",
            "patterns": [
              "/(?<![\\w-])\\d{8}[A-HJ-NP-TV-Z](?![\\w-])/",
              "/(?<![\\w-])[XYZ]\\d{7}[A-HJ-NP-TV-Z](?![\\w-])/",
              "/(?<![\\w-])\\d{3}-\\d{2}-\\d{4}(?![\\w-])/"
            ]
          }
        ]
      }
    }
  ]
}
