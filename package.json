{
  "name": "cv-tracker-extension",
  "version": "0.0.0",
  "private": true,
  "description": "Chrome/Edge MV3 extension that analyzes job offers with your own LLM API key and tracks applications locally.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:e2e": "wxt build --mode e2e",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "depcruise": "depcruise --config .dependency-cruiser.cjs src",
    "check:deps": "node scripts/check-deps.ts",
    "secretlint": "secretlint --no-gitignore \"**/*\"",
    "check:repo-policy": "node scripts/check-repo-policy.ts",
    "test": "vitest run",
    "prepare": "simple-git-hooks",
    "lint-staged": "lint-staged",
    "e2e": "wxt build --mode e2e && playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@secretlint/secretlint-rule-pattern": "13.0.7",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@swc/core": "1.16.20",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "@wxt-dev/module-react": "1.2.2",
    "dependency-cruiser": "18.7.0",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "secretlint": "13.0.7",
    "simple-git-hooks": "2.14.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wxt": "0.21.4",
    "yaml": "2.9.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm check:repo-policy --staged"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  }
}
