language js

// PRIV-11 (ADR-14 item 7, ADR-23): network egress and tab opening live in five allowlisted modules.
// Scope and allowlist are plugin `includes` globs in biome.json (plugin globs need the `**/` prefix).
or {
  // Any bare reference to the global `fetch` (call, alias `const f = fetch`, argument). Property
  // accesses such as `deps.fetch` or `{ fetch: ... }` are not identifier references and stay allowed.
  JsIdentifierExpression() as $ref where { $ref <: `fetch` },
  `$g.fetch($...)` where {
    $g <: or {
      `globalThis`,
      `self`,
      `window`
    }
  },
  `new XMLHttpRequest($...)`,
  `new WebSocket($...)`,
  `new EventSource($...)`,
  `new $g.XMLHttpRequest($...)` where {
    $g <: or {
      `globalThis`,
      `self`,
      `window`
    }
  },
  `new $g.WebSocket($...)` where {
    $g <: or {
      `globalThis`,
      `self`,
      `window`
    }
  },
  `new $g.EventSource($...)` where {
    $g <: or {
      `globalThis`,
      `self`,
      `window`
    }
  },
  `$g.open($...)` where {
    $g <: or {
      `globalThis`,
      `self`,
      `window`
    }
  },
  `chrome.tabs.create($...)`,
  `chrome.tabs.update($...)`,
  `browser.tabs.create($...)`,
  `browser.tabs.update($...)`
} as $call where {
  register_diagnostic(span=$call, message="restricted-egress: network egress and tab opening are allowed only in the allowlisted modules (PRIV-11).", severity="error")
}
